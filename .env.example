# # MelaMart — copy to .env.local (dev) or set in your hosting environment (production).
# # Never commit real values. Lines marked [required] must be set for production.

# # ── App ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=https://melamart.in

# # ── Database (MongoDB Atlas) ────────────────────────────────────────
# MONGODB_URI=
# MONGODB_DB=melamart
# USE_REAL_DB=true

# # ── Auth.js ─────────────────────────────────────────────────────────
# AUTH_SECRET=
# # Forces the canonical URL for Google OAuth callbacks. Without this, Hostinger
# # uses its internal address (0.0.0.0:3000) as redirect_uri → Google blocks it.
# AUTH_URL=https://melamart.in
# NEXTAUTH_URL=https://melamart.in
# AUTH_TRUST_HOST=true
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# # ── Cashfree Payments ───────────────────────────────────────────────
# # Rotate your keys after any accidental exposure.
# # Webhook URL: https://melamart.in/api/payments/cashfree/webhook
# # Events: PAYMENT_SUCCESS, PAYMENT_FAILED, REFUND_PROCESSED
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=

# # ── Images ──────────────────────────────────────────────────────────
# STORAGE_DIR=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# # ── Cache (optional) ────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# # ── Analytics (optional) ────────────────────────────────────────────
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_GSC_VERIFICATION=

# # ── Email (order confirmation) — Hostinger SMTP ─────────────────────
# # Hostinger cPanel → Email Accounts → your sending address
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=your-hostinger-email-password
# ORDER_EMAIL_FROM=FitAndForm <no-reply@yourdomain.com>
# ORDER_EMAIL_REPLY=support@yourdomain.com
